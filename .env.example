# Copy to .env.local for local development; configure hosting and the worker separately.
# Placeholders only. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/DATABASE?sslmode=verify-full
BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate locally, e.g. openssl rand -hex 32
AUTH0_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public browser configuration: these values are included in downloaded JavaScript.
# Use browser tokens restricted to your domains and required read-only capabilities.
NEXT_PUBLIC_MAPBOX_API_TOKEN=
NEXT_PUBLIC_CESIUM_TOKEN=
# Optional override; defaults to the site's existing public contact form.
NEXT_PUBLIC_FORMSPREE_FORM_ID=mwkgkydb
NEXT_PUBLIC_SHOW_LOGGER=false

# Explicit Auth0 user.sub allowlist. Empty means no admin access, including existing write APIs.
# Your own identifier is shown after login on /admin if access is not configured yet.
ADMIN_USER_SUBS=auth0|replace-with-your-user-id

# Required by the web app (to enable research) and the separately running worker.
# Never use NEXT_PUBLIC_ prefixes for secrets.
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-5.5

# Optional: a separate disposable local CockroachDB database, never the live DATABASE_URL.
# RESEARCH_TEST_DATABASE_URL=postgresql://root@127.0.0.1:26357/housing_research_test?sslmode=disable
